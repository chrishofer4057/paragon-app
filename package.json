{
  "name": "fiera",
  "version": "0.1.0",
  "private": true,
  "description": "Fiera – Handels- und Wirtschaftssimulation",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test && ng build",
    "start": "ng serve",
    "build": "ng build",
    "balance": "vitest run --config vitest.balance.config.ts"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "phaser": "^4.2.1",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.8.1"
  }
}
